// Prisma schema for Intelligent Email Assistant (MongoDB Atlas)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(auto()) @map("_id") @db.ObjectId
  email         String         @unique
  name          String?
  avatarUrl     String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  oauthTokens   OAuthToken[]
  emails        EmailCache[]
  executions    Execution[]
  drafts        AIDraft[]
  activityLogs  ActivityLog[]
  notifications Notification[]
  settings      UserSettings?

  @@map("users")
}

model OAuthToken {
  id                    String    @id @default(auto()) @map("_id") @db.ObjectId
  userId                String    @db.ObjectId
  provider              String    @default("google") // google, outlook, etc.
  encryptedAccessToken  String
  encryptedRefreshToken String?
  expiresAt             DateTime?
  scope                 String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@map("oauth_tokens")
}

model EmailCache {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  userId         String    @db.ObjectId
  gmailMessageId String
  threadId       String
  subject        String
  snippet        String?
  bodyHtml       String?
  bodyPlain      String?
  from           String
  to             String
  cc             String?
  bcc            String?
  labels         String    @default("INBOX") // comma-separated or JSON string
  category       String    @default("Primary") // Primary, Updates, Promotions, Social, Work
  priority       String    @default("NORMAL") // URGENT, HIGH, NORMAL, LOW
  isRead         Boolean   @default(false)
  isStarred      Boolean   @default(false)
  isArchived     Boolean   @default(false)
  isDeleted      Boolean   @default(false)
  isSpam         Boolean   @default(false)
  hasAttachments Boolean   @default(false)
  receivedAt     DateTime  @default(now())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, gmailMessageId])
  @@index([userId, threadId])
  @@index([userId, isRead])
  @@index([userId, isStarred])
  @@map("email_cache")
}

model Execution {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  userId       String    @db.ObjectId
  workflowType String    // summarize, generate_reply, explain, classify, extract_actions, compound
  status       String    @default("QUEUED") // QUEUED, RUNNING, SUCCEEDED, FAILED
  inputRef     String?   // JSON payload of workflow input
  outputRef    String?   // JSON payload of workflow output
  error        String?
  durationMs   Int?
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime  @default(now())

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  drafts       AIDraft[]

  @@index([userId, status])
  @@index([userId, workflowType])
  @@map("executions")
}

model AIDraft {
  id                     String     @id @default(auto()) @map("_id") @db.ObjectId
  userId                 String     @db.ObjectId
  threadId               String
  tone                   String     @default("Professional") // Professional, Friendly, Formal, Concise
  content                String
  instructions           String?
  createdFromExecutionId String?    @db.ObjectId
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt

  user                   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  execution              Execution? @relation(fields: [createdFromExecutionId], references: [id], onDelete: SetNull)

  @@index([userId, threadId])
  @@map("ai_drafts")
}

model ActivityLog {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  action    String   // SEND_EMAIL, SUMMARIZE_THREAD, GENERATE_REPLY, ARCHIVE_EMAIL, DELETE_EMAIL, STAR_EMAIL, DISCONNECT
  targetId  String?  // threadId or messageId or executionId
  metadata  String?  // JSON string
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("activity_log")
}

model Notification {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  type      String   // NEW_MAIL, AI_COMPLETED, AI_FAILED, SYSTEM
  payload   String   // JSON string
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@map("notifications")
}

model UserSettings {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  userId            String   @unique @db.ObjectId
  defaultTone       String   @default("Professional")
  notificationPrefs String   @default("{\"email\":true,\"inApp\":true,\"sound\":false}")
  aiProvider        String   @default("claude") // claude, openai, gemini, simulation
  aiModel           String   @default("claude-3-5-sonnet")
  autoClassify      Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}
