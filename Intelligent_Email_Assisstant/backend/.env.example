# ===================================================
# BACKEND ENVIRONMENT CONFIGURATION
# ===================================================

# Server Port
PORT=5002
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database Connection (PostgreSQL or SQLite for quick local setup)
# For SQLite local dev: "file:./dev.db"
# For PostgreSQL: "postgresql://postgres:postgres@localhost:5432/email_assistant?schema=public"
DATABASE_URL="file:./dev.db"

# Session JWT Secret (generate a secure random 32+ char string)
JWT_SECRET=super-secret-jwt-token-key-for-intelligent-email-assistant-32chars

# AES-256 Encryption Key for OAuth Tokens (must be 32 bytes hex or 32 chars)
TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Google OAuth 2.0 Credentials (from Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5002/api/auth/google/callback

# AI Provider Credentials (Provide at least one, or use Built-In Demo/Simulation Mode)
# Anthropic Claude API Key (Recommended)
ANTHROPIC_API_KEY=
# OpenAI API Key (Alternative)
OPENAI_API_KEY=
# Google Gemini API Key (Alternative)
GEMINI_API_KEY=

# Redis Connection for BullMQ Queue (Optional - falls back to built-in in-memory queue if empty or unreachable)
REDIS_URL=redis://localhost:6379

# Mock Mode (Set to true to demo without configuring real Google OAuth credentials)
MOCK_MODE=false
