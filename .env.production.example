# Production Environment Variables
# Copy to .env and fill in your actual values

# Server Configuration
PORT=5002
NODE_ENV=production
FRONTEND_URL=https://your-production-domain.com

# PostgreSQL Database (REQUIRED for production)
# Format: postgresql://user:password@host:port/database
# Get from Railway/Render/AWS dashboard
DATABASE_URL=postgresql://user:password@db-host:5432/intelligent_email_prod

# Security Keys (Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
# IMPORTANT: Must be strong random values in production!
JWT_SECRET=your-secure-random-jwt-secret-min-32-characters-here
TOKEN_ENCRYPTION_KEY=your-secure-64-character-hex-key-for-aes256gcm-encryption

# Google Cloud OAuth 2.0 Credentials
# Required to connect real Gmail accounts
# Create at: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=https://your-production-domain.com/api/auth/google/callback

# AI Provider API Keys (Optional - Intelligent Simulator runs by default)
# Get from respective provider dashboards
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=...

# Redis (Optional but recommended for production)
# If using Railway/Render, they provide Redis add-on
REDIS_URL=redis://user:password@redis-host:6379